# ---------------------------------------------------------------------------
# Ortam degiskenleri ornegi
# Bu dosyayi .env olarak kopyalayin ve gercek degerleri doldurun.
# .env DOSYASINI ASLA PAYLASMAYIN VEYA COMMIT ETMEYIN.
# ---------------------------------------------------------------------------

# ZORUNLU. Flask oturum cookie'sinin imzalanmasinda kullanilir.
# Bu deger tanimli degilse uygulama URETIMDE ACILMAZ (bilincli fail-closed
# davranis): sabit veya varsayilan bir anahtar, oturum cookie'lerinin taklit
# edilmesine izin verir.
# Yeni bir anahtar uretmek icin:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ZORUNLU (ozet ve quiz ozellikleri icin). Google AI Studio'dan alinir.
# Tanimli degilse uygulama calisir ama ozet/quiz uretilmez.
# Bu anahtar YALNIZCA sunucuda okunur, tarayiciya hicbir sekilde gonderilmez.
GEMINI_API_KEY=

# OPSIYONEL. Lokal gelistirmede debug modu icin "1" yapin.
# UYARI: Werkzeug debug arayuzu konsol uzerinden kod calistirmaya izin verir.
# URETIMDE ASLA 1 YAPMAYIN.
FLASK_DEBUG=0

# OPSIYONEL. Yuklenen dosyalarin gecici olarak yazildigi klasor.
# Tanimli degilse sistemin gecici dizini kullanilir (Vercel gibi salt-okunur
# dosya sistemlerinde de calisir).
UPLOAD_FOLDER=
